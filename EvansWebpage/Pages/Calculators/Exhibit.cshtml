@page "{id}"
@model ExhibitModel
@{
    Layout = "_CalculatorLayout";
    ViewData["Title"] = $"{Model.Exhibit.Name} - Destroyere1107's Calculator Museum";
}


<h2>@Model.Exhibit.Manufacturer @Model.Exhibit.Name</h2>

<div class="exhibit-breadcrumbs">
    <p><a href="/calculatormuseum">&laquo; Back to Calculator Museum</a></p>
    <p><a href="/calculators/directory"> &laquo; Back to Collection Index</a></p>
</div>

@if (Model.Exhibit.UnderConstruction)
{
    <img src="/assets/misc/underconstruction.png"
         alt="Under Construction"
         class="exhibit-construction-banner"/>
}

<div class="news-item">
    <h3 style="margin-top: 0">Quick Facts</h3>
    @if (!string.IsNullOrEmpty(Model.Exhibit.MainImageUrl))
    {
        <img src="@Model.Exhibit.MainImageUrl"
             alt="@Model.Exhibit.Name"
             class="exhibit-main-image"/>
    }
    <table class="exhibit-facts-table">
        <tr>
            <td><strong>Manufacturer:</strong></td>
            <td>
                <div class="exhibit-mfg-logo">
                    <img src="@Model.Exhibit.ManufacturerLogo" alt="@Model.Exhibit.Manufacturer"/>
                </div>
            </td>
        </tr>
        <tr>
            <td><strong>Model:</strong></td>
            <td>@Model.Exhibit.Model</td>
        </tr>
        @if (Model.Exhibit.YearIntroduced.HasValue)
        {
            <tr>
                <td><strong>Year Introduced:</strong></td>
                <td>@Model.Exhibit.YearIntroduced</td>
            </tr>
        }
        <tr>
            <td><strong>Type:</strong></td>
            <td>@Model.Exhibit.Type</td>
        </tr>
        @if (Model.Exhibit.MyCalcsLinks != null && Model.Exhibit.MyCalcsLinks.Any())
        {
            <tr>
                <td><strong>Similar Specimens on MyCalcs:</strong></td>
                <td>
                    @for (var i = 0; i < Model.Exhibit.MyCalcsLinks.Count; i++)
                    {
                        var link = Model.Exhibit.MyCalcsLinks[i];

                        var displayText = !string.IsNullOrEmpty(link.Name) ? link.Name : link.Id;

                        <a href="https://my.calcs.quest/search?models=@link.Id">@displayText</a>

                        // Add a space separator if it's not the last item in the list
                        @if (i < Model.Exhibit.MyCalcsLinks.Count - 1)
                        {
                            <text>&nbsp; </text>
                        }
                    }
                </td>
            </tr>
        }
    </table>
</div>

<div class="news-item">
    <h3 style="margin-top: 0">History &amp; Background</h3>
    @Html.Raw(Model.DescriptionHtml)
</div>

<div class="news-item">
    <h3 style="margin-top: 0">Specimen(s) in Collection</h3>
    @if (Model.Exhibit.Specimens != null && Model.Exhibit.Specimens.Any())
    {
        <table class="specimen-table">
            <tr>
                <th class="specimen-number-col">#</th>
                <th>Variant</th>
                <th>Serial Number</th>
                <th>Condition</th>
                <th>Pictures</th>
            </tr>
            @foreach (var specimen in Model.Exhibit.Specimens)
            {
                <tr>
                    <td class="specimen-number-col">@specimen.Number</td>
                    <td>@specimen.Variant</td>
                    <td>@specimen.SerialNumber</td>
                    <td>@specimen.Condition</td>
                    <td>
                        @if (!string.IsNullOrEmpty(specimen.ImageUrl))
                        {
                            <img src="@specimen.ImageUrl" alt="Specimen Image"
                                 class="specimen-inline-image"/>
                        }
                    </td>
                </tr>
            }
        </table>
    }
    else
    {
        <p><i>No specimens documented yet.</i></p>
    }
    @Html.Raw(Model.SpecimensHtml)
</div>

@if (Model.Exhibit.Gallery != null && Model.Exhibit.Gallery.Any())
{
    <div class="news-item">
        <h3 style="margin-top: 0">Gallery</h3>

        @foreach (var img in Model.Exhibit.Gallery)
        {
            <figure class="exhibit-gallery-figure">
                <img src="@img.Url" alt="@img.AltText"/>

                @if (!string.IsNullOrEmpty(img.Caption))
                {
                    <figcaption class="exhibit-gallery-caption">
                        @img.Caption
                    </figcaption>
                }
            </figure>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.NotesHtml))
{
    <div class="news-item">
        <h3 style="margin-top: 0">Notes</h3>
        @Html.Raw(Model.NotesHtml)
    </div>
}