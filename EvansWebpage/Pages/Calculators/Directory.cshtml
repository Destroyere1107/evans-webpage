@page
@model DirectoryModel
@{
    Layout = "_CalculatorLayout";
    ViewData["Title"] = "Calculator Directory - Destroyere1107's Calculator Museum";
}

<h2>Collection Index / Directory</h2>

<div class="exhibit-breadcrumbs">
    <p><a href="/calculatormuseum">&laquo; Back to Museum Homepage</a></p>
</div>

<p>
    Welcome to the directory of the collection. This index is generated automatically from an SQLite database.
</p>
<p>Until I have added more, this list is incomplete. Go look at my MyCalcs collection to see a more up-to-date list.</p>

<!-- Under Construction Notice -->
<div class="news-item"
     style="border-left: 3px solid #8b6914; background: linear-gradient(145deg, rgba(139, 105, 20, 0.05) 0%, rgba(0,0,0,0.1) 100%); margin-bottom: 20px;">
    <div style="display: flex; align-items: center; gap: 14px; padding: 6px 4px;">
        <i class="fa-solid fa-person-digging" style="font-size: 24px; color: #f59e0b;"></i>
        <div>
            <h4
                style="margin: 0; color: #f59e0b; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; font-weight: bold;">
                Under Construction</h4>
                <p style="margin: 4px 0 0 0; font-size: 11px; color: var(--text-muted);">
                    The Museum is unlikely to ever be truly complete, and at least some exhibits will be a general work in
                    progress. These entries are marked with a <span class="showroom-meta-tag"
                                                                style="border-color: #8b6914; color: #f59e0b; padding: 0px 3px; font-size: 7.5px;">Under
                    Construction</span> badge.
                </p>
            </div>
        </div>
    </div>

    <hr />

    @if (Model.DirectoryData.Any())
    {
        // Force a specific order so "Calculators" always appears at the top
        var orderedCategories = Model.DirectoryData
            .OrderBy(c => c.Key == "Calculator" ? 0 : c.Key == "Accessory" ? 1 : 2);

        foreach (var category in orderedCategories)
        {
            <h3 style="margin-top: 24px; margin-bottom: 12px; font-family: var(--font-heading); color: var(--accent-blue);">
                @(category.Key)s</h3>

                <div class="showroom-grid">
                    @foreach (var manufacturer in category.Value.OrderBy(m => m.Key))
                    {
                        var firstExhibit = manufacturer.Value.FirstOrDefault();
                        var count = manufacturer.Value.Count;

                        <div class="showroom-card">
                            <div class="showroom-header">
                                <h4>
                                    @if (firstExhibit != null && !string.IsNullOrEmpty(firstExhibit.Manufacturer?.LogoUrl))
                                    {
                                        <span class="showroom-logo">
                                            <img src="@firstExhibit.Manufacturer.LogoUrl" alt="@manufacturer.Key" />
                                        </span>
                                    }
                                    @manufacturer.Key
                                </h4>
                                <span class="showroom-count-pill">@count @(count == 1 ? "Specimen" : "Specimens")</span>
                            </div>

                            <ul class="showroom-list">
                                @foreach (var exhibit in manufacturer.Value)
                                {
                                    <li class="showroom-item">
                                        <a href="/calculators/exhibit/@exhibit.Id" class="showroom-link stretched-link">
                                            <span class="showroom-item-indicator"></span>
                                            @exhibit.Name
                                        </a>

                                        <div class="showroom-meta">
                                            @if (exhibit.YearIntroduced.HasValue)
                                            {
                                                <span class="showroom-meta-tag">@exhibit.YearIntroduced</span>
                                            }
                                            @if (!string.IsNullOrEmpty(exhibit.Type))
                                            {
                                                var typeClass = exhibit.Type.ToLower() switch
                                                {
                                                    "graphing" => "showroom-meta-tag-graphing",
                                                    "scientific" => "showroom-meta-tag-scientific",
                                                    "financial" => "showroom-meta-tag-financial",
                                                    "basic" => "showroom-meta-tag-basic",
                                                    _ => ""
                                                };
                                                <span class="showroom-meta-tag @typeClass">@exhibit.Type</span>
                                            }
                                            @if (exhibit.HasColor)
                                            {
                                                <span class="showroom-meta-tag showroom-meta-tag-color">Color</span>
                                            }
                                            @if (exhibit.HasCas)
                                            {
                                                <span class="showroom-meta-tag showroom-meta-tag-cas">CAS</span>
                                            }
                                            @if (exhibit.UnderConstruction)
                                            {
                                                <span class="showroom-meta-tag" style="border-color: #8b6914; color: #f59e0b;">Under
                                                    Construction</span>
                                                }
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                }
            }
else
            {
                <p><i>The directory isn't working for some reason.'</i></p>
            }

