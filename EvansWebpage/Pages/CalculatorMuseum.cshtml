@page
@model EvansWebpage.Pages.CalculatorMuseumModel
@using EvansWebpage.Pages.Shared
@{
    ViewData["Title"] = "Calculator Museum - Destroyere1107's Home Page";
    ViewData["ActiveNav"] = "nav-calculator-museum";
    ViewData["HideSidebar"] = true;
}

<div id="content">

    <!-- Hero Section -->
    <div class="museum-hero">
        <h2>Calculator Museum</h2>
        <p class="subtitle" style="align-content: center">
            A collection dedicated to the storied and varied history of the calculator.
        </p>
        <p>
            Welcome to my calculator museum! This page is dedicated to
            showcasing my collection of calculators, alongside their history
            (something generally underappreciated in the world.)
        </p>
        <a href="/calculators/directory" class="cta-button">
            <i class="fa-solid fa-door-open"></i> Enter the Collection
        </a>
    </div>

    <!-- Museum Stats -->
    <div class="museum-stats">
        <div class="stat-pills">
            <div class="stat-pill">
                <i class="fa-solid fa-calculator"></i>
                <span class="stat-number">@Model.TotalCalculators</span>
                <span class="stat-label">Calculators</span>
            </div>
            <div class="stat-pill">
                <i class="fa-solid fa-industry"></i>
                <span class="stat-number">@Model.TotalManufacturers</span>
                <span class="stat-label">Manufacturers</span>
            </div>
            <div class="stat-pill">
                <i class="fa-solid fa-cubes"></i>
                <span class="stat-number">@Model.TotalSpecimens</span>
                <span class="stat-label">Specimens</span>
            </div>
            <div class="stat-pill">
                <i class="fa-solid fa-calendar-days"></i>
                <span class="stat-number">@Model.YearRange</span>
                <span class="stat-label">Year Span</span>
            </div>
            <div class="stat-pill">
                <i class="fa-solid fa-camera-retro"></i>
                <span class="stat-number">@Model.TotalPhotos</span>
                <span class="stat-label">Total Photos</span>
            </div>
            <div class="stat-pill">
                <i class="fa-solid fa-camera-retro"></i>
                <span class="stat-number">@Model.DocumentedSpecimens of @Model.TotalSpecimens</span>
                <span class="stat-label">Specimens have Pictures</span>
            </div>
            @if (Model.OldestCalculator != null)
            {
                <div class="stat-pill stat-pill-wide">
                    <i class="fa-solid fa-hourglass-start"></i>
                    <span class="stat-number">@Model.OldestCalculator.YearIntroduced</span>
                    <span class="stat-label">Oldest Calculator - @Model.OldestCalculator.Name</span>
                </div>
            }
            @if (Model.NewestCalculator != null)
            {
                <div class="stat-pill stat-pill-wide">
                    <i class="fa-solid fa-hourglass-end"></i>
                    <span class="stat-number">@Model.NewestCalculator.YearIntroduced</span>
                    <span class="stat-label">Newest Calculator - @Model.NewestCalculator.Name</span>
                </div>
            }
        </div>
    </div>

    <!-- Featured Exhibits -->
    <h2>Featured Exhibits</h2>
    <div class="museum-featured">

        <!-- Calculator of the Month -->
        <partial name="_ExhibitCardPartial" model="@(new ExhibitCardViewModel
                 {
                     Exhibit = Model.ExhibitOfTheMonth,
                     Description = Model.ExhibitOfTheMonthDescription,
                     BadgeText = "Calculator of the Month",
                     BadgeClass = "badge-featured",
                     BadgeIcon = "fa-solid fa-star"
                 })" />

        <!-- Curator's Choice -->
        <partial name="_ExhibitCardPartial" model="@(new ExhibitCardViewModel
                 {
                     Exhibit = Model.CuratorsChoice,
                     Description = Model.CuratorsChoiceDescription,
                     BadgeText = "Curator\u0027s Choice",
                     BadgeClass = "badge-curators",
                     BadgeIcon = "fa-solid fa-bullseye"
                 })" />

        <!-- Newest Addition -->
        <partial name="_ExhibitCardPartial" model="@(new ExhibitCardViewModel
                 {
                     Exhibit = Model.NewestAddition,
                     Description = Model.NewestAdditionDescription,
                     BadgeText = "Newest Addition",
                     BadgeClass = "badge-newest",
                     BadgeIcon = "fa-solid fa-box-open"
                 })" />

        <!-- Random from the Collection -->
        <partial name="_ExhibitCardPartial" model="@(new ExhibitCardViewModel
                 {
                     Exhibit = Model.RandomExhibit,
                     Description = Model.RandomExhibitDescription,
                     BadgeText = "Random from the Collection",
                     BadgeClass = "badge-random",
                     BadgeIcon = "fa-solid fa-dice"
                 })" />

    </div>

    <!-- Explore the Collection -->
    <h2>Explore the Collection</h2>
    <div class="museum-explore">
        <p>
            For a fully up-to-date directory of my collection, check out my
            profile on MyCalcs...
        </p>
        <a href="https://my.calcs.quest/u/1475?ref=1475" title="Destroyere1107's MyCalcs profile">
            <picture>
                <source width="350px" height="19px" media="(prefers-color-scheme: dark)"
                        srcset="https://my.calcs.quest/userbar/1475?style=dark 1x, https://my.calcs.quest/userbar/1475?style=dark&amp;supersize=1 2x" />
                <img loading="lazy" width="350px" height="19px" src="https://my.calcs.quest/userbar/1475"
                     srcset="https://my.calcs.quest/userbar/1475?supersize=1 2x"
                     alt="Destroyere1107's MyCalcs userbar" />
            </picture>
        </a>

        <p>
            ...or take a look at the exhibit directory by clicking the button
            below - If you dare!
        </p>
        <a href="/calculators/directory" class="cta-button">
            <i class="fa-solid fa-book-open"></i> Collection Index
        </a>
        <p><sup>That's also another button you can take.</sup></p>
    </div>

    <!-- Why Calculators? -->
    <h3>Why Calculators?</h3>
    <div class="museum-why">
        <p><i>Autism.</i></p>

        <p>
            In all seriousness, I've always been fascinated by calculators.
            They're a dying breed of technology that once was the forefront in
            the cutting edge of electronics.
        </p>

        <p>My hope is to preserve some of that lovely history.</p>
    </div>

    <!-- License notice -->
    <partial name="_CalcLicensePartial" />
</div>

<div id="sidebar">
    <partial name="_CalcSidebarPartial" />
    <partial name="_SidebarPartial" />
</div>
